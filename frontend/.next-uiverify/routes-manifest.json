{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "http://localhost:8000/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/uploads/:path*",
        "destination": "http://localhost:8000/uploads/:path*",
        "regex": "^/uploads(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/claims/[id]",
      "regex": "^/claims/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/claims/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/documents/verify/[id]",
      "regex": "^/documents/verify/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/documents/verify/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/atlas",
      "regex": "^/atlas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/atlas(?:/)?$"
    },
    {
      "page": "/audit",
      "regex": "^/audit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/audit(?:/)?$"
    },
    {
      "page": "/claims",
      "regex": "^/claims(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/claims(?:/)?$"
    },
    {
      "page": "/dss",
      "regex": "^/dss(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dss(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/monitoring",
      "regex": "^/monitoring(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/monitoring(?:/)?$"
    },
    {
      "page": "/schemes",
      "regex": "^/schemes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/schemes(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}