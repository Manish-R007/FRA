# ==============================================================================
# COPERNICUS SENTINEL HUB (COPERNICUS DATA SPACE ECOSYSTEM - CDSE)
# ==============================================================================
# Register for CDSE credentials at: https://dataspace.copernicus.eu/
# Obtain OAuth2 Client ID and Client Secret from:
# https://identity.dataspace.copernicus.eu/auth/realms/CDSE/account
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""

# CDSE Service Endpoints
SENTINEL_HUB_TOKEN_URL="https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"
SENTINEL_HUB_PROCESS_URL="https://sh.dataspace.copernicus.eu/process/v1"
SENTINEL_HUB_CATALOG_URL="https://sh.dataspace.copernicus.eu/catalog/v1.0"

# Sentinel-2 Processing Thresholds
SENTINEL_HUB_MAX_CLOUD_COVER=20.0
SENTINEL_HUB_DEFAULT_RESOLUTION=10.0

# ==============================================================================
